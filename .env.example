# Public address of this Watermark, no trailing slash
BASE_URL=https://watermark.krafftco.com
# Studio sign-in
ADMIN_PASSWORD=change-me
SESSION_SECRET=a-long-random-string
# Where the database and originals live (mount a persistent disk here)
DATA_DIR=/data
# The vault: S3 (or Cloudflare R2 with S3_ENDPOINT). Empty S3_BUCKET keeps files on local disk.
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
# Watermark's own key: originals are sealed with it before they leave the server. 32+ random characters.
# Keep a copy in two safe places. Never change it on a vault that already holds files.
VAULT_KEY=
# Stripe (test keys first). Leave empty to take requests and quote by hand.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The house maker
MAKER_HANDLE=krafft
MAKER_NAME=Will Fullerton
MAKER_HOUSE=Krafft Studios
MAKER_EMAIL=will@krafftco.com
# Email via Resend (optional)
RESEND_API_KEY=
MAIL_FROM=Watermark <license@krafftco.com>
